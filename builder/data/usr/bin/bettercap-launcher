#!/usr/bin/env bash
source /usr/bin/pwnlib

# we need to decrypt something
if is_crypted_mode; then
  while ! is_decrypted; do
    echo "Waiting for decryption..."
    sleep 1
  done
fi

if ! check_brcm; then
  reload_brcm
  reload_rc=$?
  if [ "$reload_rc" -eq "$RELOAD_BRCM_SKIPPED" ]; then
    echo "wifi driver reload is within its cooldown -- continuing without reloading"
  elif [ "$reload_rc" -ne 0 ]; then
    if brcm_reboot_allowed; then
      echo "Could not reload wifi driver. Reboot"
      reboot
    else
      echo "Could not reload wifi driver, but the brcm reboot budget is exhausted -- continuing without rebooting"
    fi
  fi
  sleep 10
fi

# start mon0
if ! is_interface_up 'mon0'; then
  start_monitor_interface
else
  stop_monitor_interface
  start_monitor_interface
fi

if is_auto_mode_no_delete; then
  /usr/bin/bettercap -no-colors -caplet pwnagotchi-auto -iface mon0
else
  /usr/bin/bettercap -no-colors -caplet pwnagotchi-manual -iface mon0
fi
