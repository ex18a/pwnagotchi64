#!/usr/bin/env bash

hardware_led_enabled() {
  python3 - <<'PY' 2>/dev/null
import os, sys, toml
try:
    import pwnagotchi
    defaults = toml.load(os.path.join(os.path.dirname(pwnagotchi.__file__), 'defaults.toml'))
except Exception:
    sys.exit(0)
enabled = defaults.get('main', {}).get('hardware_led', True)
try:
    user = toml.load('/etc/pwnagotchi/config.toml')
    if 'hardware_led' in user.get('main', {}):
        enabled = user['main']['hardware_led']
except Exception:
    pass
sys.exit(0 if enabled else 1)
PY
}

blink_led() {
  local led_dir=/sys/class/leds/led0
  [ -d "$led_dir" ] || led_dir=/sys/class/leds/ACT

  for i in $(seq 1 "$1"); do
    echo 0 | tee "$led_dir/brightness"
    sleep 0.3
    echo 1 | tee "$led_dir/brightness"
    sleep 0.3
  done

  if hardware_led_enabled; then
    echo mmc0 | tee "$led_dir/trigger"
  else
    echo none | tee "$led_dir/trigger"
    echo 0 | tee "$led_dir/brightness"
  fi
}

check_brcm() {
  if [[ "$(journalctl -n10 -k --since -5m | grep -c 'brcmf_cfg80211_nexmon_set_channel.*Set Channel failed')" -ge 5 ]]; then
    return 1
  fi
  if [[ "$(journalctl -k --since -10m 2>/dev/null | grep -c 'brcmf_psm_watchdog_notify')" -ge 3 ]]; then
    return 1
  fi
  return 0
}

reload_brcm() {
  if ! modprobe -r brcmfmac; then
    return 1
  fi
  if ! modprobe brcmfmac; then
    return 1
  fi
  return 0
}

start_monitor_interface() {
  rfkill unblock all
  iw dev wlan0 set power_save off

  ifconfig wlan0 up

  if ip link show mon0 &>/dev/null && iw dev mon0 info &>/dev/null; then
    ifconfig mon0 up
  else
    iw dev mon0 del &>/dev/null
    iw phy "$(iw phy | head -1 | cut -d" " -f2)" interface add mon0 type monitor && ifconfig mon0 up
  fi

  ifconfig wlan0 down

  ip link show mon0 up &>/dev/null
}

stop_monitor_interface() {
  ifconfig mon0 down && iw dev mon0 del
  ifconfig wlan0 up
}

is_interface_up() {
  if grep -qi 'up' /sys/class/net/$1/operstate; then
    return 0
  else
    return 1
  fi
}

is_auto_mode() {
  if [ -f /root/.pwnagotchi-manual ]; then
    rm -rf /root/.pwnagotchi-manual
    return 1
  fi

  if [ -f /root/.pwnagotchi-auto ]; then
    rm -rf /root/.pwnagotchi-auto
    return 0
  fi

  return 0
}

is_auto_mode_no_delete() {
  if [ -f /root/.pwnagotchi-manual ]; then
    return 1
  fi

  if [ -f /root/.pwnagotchi-auto ]; then
    return 0
  fi

  return 0
}

is_crypted_mode() {
  if [ -f /root/.pwnagotchi-crypted ]; then
    return 0
  fi
  return 1
}

is_decrypted() {
  while read -r mapping container mount; do
    if ! mountpoint -q "$mount" >/dev/null 2>&1; then
      if [ -f /tmp/.pwnagotchi-secret-"$mapping" ]; then
        </tmp/.pwnagotchi-secret-"$mapping" read -r SECRET
        if ! test -b /dev/disk/by-id/dm-uuid-*"$(cryptsetup luksUUID "$container" | tr -d -)"*; then
          if echo -n "$SECRET" | cryptsetup luksOpen -d- "$container" "$mapping" >/dev/null 2>&1; then
            echo "Container decrypted!"
          fi
        fi

        if mount /dev/mapper/"$mapping" "$mount" >/dev/null 2>&1; then
            echo "Mounted /dev/mapper/$mapping to $mount"
            continue
        fi
      fi

      if ! ip -4 addr show wlan0 | grep inet >/dev/null 2>&1; then
        >/dev/null 2>&1 ip addr add 192.168.0.10/24 dev wlan0
      fi

      if ! pgrep -f decryption-webserver >/dev/null 2>&1; then
        >/dev/null 2>&1 decryption-webserver &
      fi

      if ! pgrep wpa_supplicant >/dev/null 2>&1; then
        >/tmp/wpa_supplicant.conf cat <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
ap_scan=2

network={
    ssid="DECRYPT-ME"
    mode=2
    key_mgmt=WPA-PSK
    psk="pwnagotchi"
    frequency=2437
}
EOF
        >/dev/null 2>&1 wpa_supplicant -u -s -O -D nl80211 -i wlan0 -c /tmp/wpa_supplicant.conf &
      fi

      if ! pgrep dnsmasq >/dev/null 2>&1; then
        >/dev/null 2>&1 dnsmasq -k -p 53 -h -O "6,192.168.0.10" -A "/#/192.168.0.10" -i wlan0 -K -F 192.168.0.50,192.168.0.60,255.255.255.0,24h &
      fi

      return 1
    fi
  done </root/.pwnagotchi-crypted

  python3 -c 'print("A"*4096)' | tee /tmp/.pwnagotchi-secret-* >/dev/null
  rm /tmp/.pwnagotchi-secret-*
  sync

  pkill wpa_supplicant
  pkill dnsmasq
  pid="$(pgrep -f "decryption-webserver")"
  [[ -n "$pid" ]] && kill "$pid"

  return 0
}
