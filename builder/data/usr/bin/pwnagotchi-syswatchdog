#!/usr/bin/env bash

set -u

source /usr/bin/pwnlib

LOG_FILE="/var/log/pwnagotchi.log"
CRASH_LOG="/var/log/pwnagotchi_crashes.log"
WATCHDOG_LOG="/var/log/pwnagotchi-syswatchdog.log"
BOOT_GRACE_SECONDS=300
LOG_STALE_SECONDS=600
BETTERCAP_MAX_RESTARTS=3
CPU_TEMP_PAUSE_C=70
CPU_TEMP_RESUME_C=50
CPU_TEMP_HARD_REBOOT_C=85
CPU_HOT_PAUSE_MARKER="/run/pwnagotchi-syswatchdog-hot-pause"
BRCM_RECOVERY_MARKER="/run/pwnagotchi-syswatchdog-brcm-recovery"
BRCM_REBOOT_HISTORY="/var/lib/pwnagotchi/brcm-reboot-history"
BRCM_REBOOT_MAX=3
BRCM_REBOOT_WINDOW_SECONDS=3600
PIP_INSTALL_MAX_SECONDS=240
USB0_GATEWAY="10.42.0.1"
UPDATE_MAINTENANCE_MARKER="/run/pwnagotchi-automatic-updates-maintenance"

log() {
    logger -t pwnagotchi-syswatchdog "$1"
    echo "$(date -Is) $1" >> "$WATCHDOG_LOG"
}

brcm_reboots_in_window() {
    local now cutoff ts kept="" count=0
    now="$(date +%s)"
    cutoff=$((now - BRCM_REBOOT_WINDOW_SECONDS))
    if [ -f "$BRCM_REBOOT_HISTORY" ]; then
        while read -r ts; do
            case "$ts" in ''|*[!0-9]*) continue ;; esac
            if [ "$ts" -gt "$cutoff" ]; then
                kept="${kept}${ts}"$'\n'
                count=$((count + 1))
            fi
        done < "$BRCM_REBOOT_HISTORY"
    fi
    mkdir -p "$(dirname "$BRCM_REBOOT_HISTORY")" 2>/dev/null
    printf '%s' "$kept" > "$BRCM_REBOOT_HISTORY" 2>/dev/null
    printf '%s' "$count"
}

record_brcm_reboot() {
    mkdir -p "$(dirname "$BRCM_REBOOT_HISTORY")" 2>/dev/null
    date +%s >> "$BRCM_REBOOT_HISTORY" 2>/dev/null
    sync
}

brcm_recover_or_reboot() {
    local reason="$1" used
    used="$(brcm_reboots_in_window)"
    if [ "$used" -ge "$BRCM_REBOOT_MAX" ]; then
        log "CRITICAL: $reason -- but ${used} brcm reboots already happened in the last $((BRCM_REBOOT_WINDOW_SECONDS / 60))min, so NOT rebooting and NOT attempting the host controller rebind. Staying up as-is so the device keeps whatever wifi it still has and stays reachable for diagnosis."
        return 1
    fi
    if reset_brcm_host_controller; then
        log "$reason -- SDIO host controller rebind recovered the chip, no reboot needed"
        sleep 5
        systemctl restart bettercap
        return 0
    fi
    record_brcm_reboot
    reboot_with_reason "$reason (host controller rebind also failed; brcm reboot $((used + 1)) of ${BRCM_REBOOT_MAX} in window)"
    return 1
}

reboot_with_reason() {
    reason="$1"
    log "CRITICAL: $reason -- rebooting"
    {
        echo "------------ SYSWATCHDOG REBOOT: $(date -Is) ------------"
        echo "reason: $reason"
        echo "--- systemctl status pwnagotchi ---"
        systemctl status pwnagotchi --no-pager -l 2>&1 | tail -30
        echo "--- systemctl status bettercap ---"
        systemctl status bettercap --no-pager -l 2>&1 | tail -30
        echo "--- dmesg tail ---"
        dmesg | tail -50
        echo
    } >> "$CRASH_LOG" 2>/dev/null
    touch /root/.pwnagotchi-auto 2>/dev/null
    sync
    reboot
}

pip_pid=$(pgrep -f 'pip3 install .*--no-build-isolation' | head -1)
if [ -n "$pip_pid" ]; then
    elapsed=$(ps -o etimes= -p "$pip_pid" 2>/dev/null | tr -d ' ')
    if [ -n "$elapsed" ] && [ "$elapsed" -ge "$PIP_INSTALL_MAX_SECONDS" ]; then
        reboot_with_reason "pip install (pid $pip_pid) running ${elapsed}s >= ${PIP_INSTALL_MAX_SECONDS}s -- confirmed recurring memory-pressure hang on this device"
    fi
fi

uptime_seconds=$(awk '{print int($1)}' /proc/uptime)
if [ "$uptime_seconds" -lt "$BOOT_GRACE_SECONDS" ]; then
    exit 0
fi

if ip link show usb0 >/dev/null 2>&1; then
    if ping -c 2 -W 2 -I usb0 "$USB0_GATEWAY" >/dev/null 2>&1; then
        ip route replace default via "$USB0_GATEWAY" dev usb0 metric 20 2>/dev/null
    elif ip route show default | grep -q "dev usb0"; then
        log "usb0 default route present but gateway $USB0_GATEWAY unreachable -- removing stale route"
        ip route del default via "$USB0_GATEWAY" dev usb0 metric 20 2>/dev/null
    fi
fi

if ! check_brcm; then
    if [ -f "$BRCM_RECOVERY_MARKER" ]; then
        brcm_recover_or_reboot "brcmfmac still flaky after an earlier reload_brcm attempt this boot -- reload didn't hold"
        exit 0
    fi
    log "brcmfmac flakiness detected -- attempting reload_brcm (no reboot) ..."
    touch "$BRCM_RECOVERY_MARKER"
    reload_brcm
    reload_rc=$?
    if [ "$reload_rc" -eq 0 ]; then
        sleep 10
        systemctl restart bettercap
        log "reload_brcm succeeded, bettercap restarted"
    elif [ "$reload_rc" -eq "$RELOAD_BRCM_SKIPPED" ]; then
        log "brcmfmac flaky but reload_brcm is within its ${RELOAD_BRCM_COOLDOWN_SECONDS}s cooldown -- skipping this cycle rather than wedging the SDIO bus"
        rm -f "$BRCM_RECOVERY_MARKER"
        exit 0
    else
        brcm_recover_or_reboot "reload_brcm failed outright"
        exit 0
    fi
fi

temp_millic=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)
temp_c=$(( temp_millic / 1000 ))

if [ "$temp_c" -ge "$CPU_TEMP_HARD_REBOOT_C" ]; then
    reboot_with_reason "CPU temp ${temp_c}C >= ${CPU_TEMP_HARD_REBOOT_C}C -- genuinely dangerous, rebooting"
    exit 0
fi

if [ -f "$CPU_HOT_PAUSE_MARKER" ]; then
    if [ "$temp_c" -le "$CPU_TEMP_RESUME_C" ]; then
        log "CPU cooled to ${temp_c}C (<= ${CPU_TEMP_RESUME_C}C) -- resuming"
        rm -f "$CPU_HOT_PAUSE_MARKER"
        systemctl start bettercap
        systemctl start pwnagotchi
    fi
    exit 0
fi

if [ "$temp_c" -ge "$CPU_TEMP_PAUSE_C" ]; then
    log "CPU temp ${temp_c}C >= ${CPU_TEMP_PAUSE_C}C -- pausing until it cools to ${CPU_TEMP_RESUME_C}C"
    touch "$CPU_HOT_PAUSE_MARKER"
    systemctl stop pwnagotchi
    /usr/local/bin/pwnagotchi --show-message "Im too hot... taking a break!" 2>/dev/null
    systemctl stop bettercap
    exit 0
fi

if [ ! -f "$UPDATE_MAINTENANCE_MARKER" ] && [ "$(systemctl is-active bettercap)" != "active" ]; then
    restarts=$(systemctl show bettercap -p NRestarts --value 2>/dev/null || echo 0)
    if [ "${restarts:-0}" -ge "$BETTERCAP_MAX_RESTARTS" ]; then
        reboot_with_reason "bettercap crash-looping (NRestarts=$restarts, currently inactive)"
        exit 0
    fi
fi

if [ ! -f "$UPDATE_MAINTENANCE_MARKER" ] && [ "$(systemctl is-active pwnagotchi)" = "active" ] && [ -f "$LOG_FILE" ]; then
    last_write=$(stat -c %Y "$LOG_FILE" 2>/dev/null || echo 0)
    now=$(date +%s)
    age=$(( now - last_write ))
    if [ "$age" -ge "$LOG_STALE_SECONDS" ]; then
        reboot_with_reason "pwnagotchi.log stale for ${age}s (threshold ${LOG_STALE_SECONDS}s)"
        exit 0
    fi
fi

exit 0
